# Copy this file to .env.local and adjust as needed.

# Where the SQLite database file lives (created automatically on first run).
DATABASE_PATH=./data/pinjam.db

# Where uploaded images (item photos, avatars, student ID cards) are stored.
UPLOAD_DIR=./data/uploads

# Comma-separated list of email domains allowed to register.
ALLOWED_EMAIL_DOMAINS=binus.ac.id

# Display strings for the campus this deployment serves.
NEXT_PUBLIC_UNIVERSITY_NAME=Binus University
NEXT_PUBLIC_CAMPUS_NAME=Alam Sutera
