# Copy this file to .env.local for local development (never commit .env.local).
# On Vercel, set the same variables in Project → Settings → Environment Variables.

# Neon Postgres — POOLED connection string (host contains "-pooler"). Used by the app.
# Neon console → your project → Connect → "Connection pooling" on.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Neon Postgres — DIRECT connection string (no "-pooler"). Used by `npm run db:migrate`.
# Optional: falls back to DATABASE_URL when unset.
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full

# Comma-separated list of email domains allowed to register.
ALLOWED_EMAIL_DOMAINS=binus.ac.id

# Campus time zone for "today", due dates and displayed times (servers run in UTC).
NEXT_PUBLIC_TIME_ZONE=Asia/Jakarta

# Display strings for the campus this deployment serves.
NEXT_PUBLIC_UNIVERSITY_NAME=Binus University
NEXT_PUBLIC_CAMPUS_NAME=Alam Sutera
